## @file
#  fuxiPkg FuxiKeyInputDxe
#
#  Power / volume keys through the SPMI PMIC arbiter, presented as SimpleTextIn.
#  Ported from shengPkg ShengKeyInputDxe.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION                    = 0x0001001B
  BASE_NAME                      = FuxiKeyInputDxe
  FILE_GUID                      = E2A5C7D9-4F13-4B68-A07E-9C52D1B83F60
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = FuxiKeyInputDxeEntry

[Sources]
  FuxiKeyInputDxe.c
  FuxiSpmiKeys.h

[Packages]
  MdePkg/MdePkg.dec

[LibraryClasses]
  BaseLib
  DevicePathLib
  UefiRuntimeServicesTableLib
  BaseMemoryLib
  DebugLib
  MemoryAllocationLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint
  UefiLib

[Protocols]
  gEfiSimpleTextInProtocolGuid                  ## PRODUCES
  gEfiDevicePathProtocolGuid                    ## PRODUCES

[Guids]
  gEfiEventExitBootServicesGuid                 ## CONSUMES
  gEfiGlobalVariableGuid                        ## PRODUCES

[Depex]
  gEfiTimerArchProtocolGuid AND gEfiVariableArchProtocolGuid AND gEfiVariableWriteArchProtocolGuid
