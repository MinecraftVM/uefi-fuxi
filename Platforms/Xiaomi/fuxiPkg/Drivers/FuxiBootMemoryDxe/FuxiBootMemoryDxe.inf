## @file
#  fuxiPkg FuxiBootMemoryDxe
#
#  Publishes DRAM described by the handed-over device tree and the initrd as a
#  read-only block device. Ported from shengPkg ShengBootMemoryDxe.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION                    = 0x0001001B
  BASE_NAME                      = FuxiBootMemoryDxe
  FILE_GUID                      = 7B3D1E64-92A5-4C07-8F1B-6D4E2A9C5803
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = FuxiBootMemoryDxeEntry

[Sources]
  FuxiBootMemoryDxe.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  SiliciumPkg/SiliciumPkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DebugLib
  DxeServicesTableLib
  FdtLib
  HobLib
  MemoryAllocationLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint

[Guids]
  gSiliciumEntryArgHobGuid                      ## CONSUMES

[Protocols]
  gEfiBlockIoProtocolGuid                       ## PRODUCES
  gEfiDevicePathProtocolGuid                    ## PRODUCES

[Depex]
  TRUE
